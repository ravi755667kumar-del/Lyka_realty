# Server Configuration
PORT=5000

# Supabase Authentication & Persistent Database (Optional - runs in store.json fallback if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Multi-Model AI Mentor APIs
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model Mode: council | openai | deepseek | qwen
VITE_AI_MODEL=council

# Live Google Web Search (SerpApi)
SERPAPI_KEY=your_serpapi_key_here

# Text-to-Speech Engine (Cartesia Sonic / Local OpenAI TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
OPENAI_TTS_URL=http://localhost:5050/v1

# Model Context Protocol (MCP) Integration (Users can also configure directly via UI modal)
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

