# =========================================================================
# AI STUDY MENTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API keys
# =========================================================================

# Server Port
PORT=5055

# -------------------------------------------------------------------------
# Active AI Model & Search API Keys
# -------------------------------------------------------------------------
# 1. NVIDIA API (NIM Gateway: DeepSeek-V4.1-Flash, Nemotron, Llama Vision)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 2. Groq API (High-speed Qwen 3.8-27B for Architecture & Mermaid Diagrams)
GROQ_API_KEY=your_groq_api_key_here

# 3. SerpApi (Live Google & Chrome Search Digestion - Zero Copy-Paste)
SERPAPI_KEY=your_serpapi_key_here

# 4. Voice TTS Engine Key
tts_api=your_tts_api_key_here

# 5. OmniRoute Local AI Router (Keyless Virtual Combo: http://localhost:20128/v1)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
USE_OMNIROUTE=false

# 6. Sarvam AI (Indic Text-to-Speech & Speech Synthesis: Tamil, Tanglish, English)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEAKER=anushka
SARVAM_LANGUAGE_CODE=en-IN
