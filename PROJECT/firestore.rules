rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '950323243501@gracecoe.org' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
        data.consent is bool &&
        data.blocked is bool &&
        data.status is string && data.status.size() <= 50;
    }

    function isValidCampaign(data) {
      return data.isRunning is bool &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100));
    }

    // Lead rules: Authenticated access only + strict schema validation
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leadId) && isValidLead(incoming());
      allow update: if isSignedIn() && isValidId(leadId);
      allow delete: if isAdmin() && isValidId(leadId);
    }

    // Calls collection rules: Authenticated access only
    match /calls/{callId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(callId);
      allow update: if isSignedIn() && isValidId(callId);
      allow delete: if isAdmin() && isValidId(callId);
    }

    // Campaign state rules: Authenticated access only
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(campaignId) && isValidCampaign(incoming());
    }

    // Knowledge docs rules: Authenticated read, admin write
    match /knowledge_docs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(docId) &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().content is string && incoming().content.size() <= 20000;
    }

    // Properties collection rules: Authenticated read for dashboard; admin write only
    match /properties/{propertyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection doc: Authenticated check only
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // Admins collection: Restrict to admins or self lookup; never public
    match /admins/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }
  }
}

