# ==============================================================================
# Supabase Configuration
# Obtain your project URL & Anon Key from: https://app.supabase.com/project/_/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server Port
PORT=3001

# Optional AI Services Configuration
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Sarvam AI (Bulbul TTS & Saaras STT for Indian languages)
SARVAM_API_KEY=

# Groq AI (Llama 3.1 70B Fast LLM)
GROQ_API_KEY=

# Additional TTS providers
HUME_API_KEY=
NVIDIA_API_KEY=
# Optional custom NVIDIA Riva endpoint; defaults to NVIDIA-hosted Riva TTS.
NVIDIA_TTS_ENDPOINT=https://ai.api.nvidia.com/v1/genai/nvidia/riva-tts

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API (Whisper STT, OpenAI TTS, GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Hugging Face Inference Providers (Kokoro TTS)
HF_TOKEN=
