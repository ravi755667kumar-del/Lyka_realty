rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User login/profile - authenticated user can read/write their own document (by uid or email)
    match /User_login/{docId} {
      allow read: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.Email_id == request.auth.token.email
      );
      allow create: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        request.resource.data.uid == request.auth.uid || 
        request.resource.data.Email_id == request.auth.token.email
      );
      allow update: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        resource.data.uid == request.auth.uid || 
        resource.data.Email_id == request.auth.token.email
      );
      allow delete: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        resource.data.uid == request.auth.uid || 
        resource.data.Email_id == request.auth.token.email
      );
    }

    // Standard users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User chat history - only the user themselves
    match /user_chat/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Interactions (individual messages) - authenticated users only
    match /interactions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Leads - only the user who owns the lead
    match /leads/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    // Follow-ups - authenticated users only
    match /followups/{docId} {
      allow read, write: if request.auth != null;
    }

    // Properties - public read, admin write
    match /properties/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}