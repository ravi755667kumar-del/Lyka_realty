rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User login/profile - authenticated user can read/write their own document (by uid or email)
    match /User_login/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        (request.resource != null && request.resource.data.uid == request.auth.uid) || 
        (request.resource != null && request.resource.data.Email_id == request.auth.token.email)
      );
      allow update: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        (resource != null && resource.data.uid == request.auth.uid) || 
        (resource != null && resource.data.Email_id == request.auth.token.email) ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        docId == request.auth.uid || 
        docId == request.auth.token.email || 
        (resource != null && resource.data.uid == request.auth.uid) || 
        (resource != null && resource.data.Email_id == request.auth.token.email)
      );
    }

    // Standard users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User chat history - only the user themselves
    match /user_chat/{docId} {
      allow read, write: if request.auth != null;
    }

    // Interactions (individual messages) - authenticated users only
    match /interactions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Leads - only the user who owns the lead
    match /leads/{docId} {
      allow read, write: if request.auth != null;
    }

    // Follow-ups - authenticated users only
    match /followups/{docId} {
      allow read, write: if request.auth != null;
    }

    // Properties - public read, admin write
    match /properties/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Login events tracking
    match /login_events/{docId} {
      allow read, write: if request.auth != null;
    }

    // Admin & Property Manager login credentials
    match /Admin_login/{docId} {
      allow read, write: if true;
    }
    match /Property_login/{docId} {
      allow read, write: if true;
    }

    // PDF Knowledge and Vector Embeddings
    match /pdf_knowledge_embeddings/{docId} {
      allow read, write: if true;
    }
    match /customer_embeddings/{docId} {
      allow read, write: if true;
    }
    match /property_embeddings/{docId} {
      allow read, write: if true;
    }
    match /vector_embeddings/{docId} {
      allow read, write: if true;
    }

    // Fallback for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}