# Copy to .env.local. Never commit credentials or server-owned data.
# Node 24+ and npm 11; run npm ci, npm run dev.
PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Set true behind HTTPS in production.
# Bootstrap creates the FIRST admin only. Changes later use Access settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password must contain at least 12 characters; no built-in login exists.
REQUIRE_PORTAL_OTP=false
# Local durable storage; use a persistent disk in deployment.
DATA_FILE=data/lyka.sqlite
# Optional PostgreSQL. When set, startup fails if unavailable; no silent fallback.
DATABASE_URL=
# Fictional sample records: never enable on a production customer database.
SEED_DEMO=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
REQUIRED_LISTING_FIELDS=property_type,listing_purpose,community,price_aed,size_sqft,bedrooms,bathrooms,contact_name,contact_mobile
